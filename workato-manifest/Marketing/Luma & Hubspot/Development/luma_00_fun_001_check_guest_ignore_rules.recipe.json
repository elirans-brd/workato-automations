                "schema": "[{\"control_type\":\"text\",\"label\":\"email\",\"name\":\"email\",\"type\":\"string\",\"optional\":true,\"details\":{\"real_name\":\"email\"},\"parent\":[\"parameters\",\"data\"]},{\"name\":\"domain\",\"type\":\"string\",\"optional\":true,\"label\":\"domain\",\"details\":{\"real_name\":\"domain\"},\"control_type\":\"text\",\"parent\":[\"parameters\",\"data\"]}]"
