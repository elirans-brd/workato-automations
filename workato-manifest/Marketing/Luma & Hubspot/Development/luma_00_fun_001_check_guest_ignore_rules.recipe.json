          {
            "as": "e0f00005",
            "comment": "ignore decision (ignore list + blocked country)",
            "description": "Execute \u003cspan class=\"provider\"\u003eruby\u003c/span\u003e code: \u003cspan class=\"provider\"\u003echeck_guest_ignore\u003c/span\u003e",
            "input": {
              "code": "clean = -\u003e(v) { (v.nil? || v.to_s.strip.empty?) ? nil : v }\nnorm  = -\u003e(v) { v.to_s.strip.downcase.gsub(/\\s+/, \" \") }\nparse = -\u003e(v) {\n  v = (parse_json(v) rescue nil) while v.is_a?(String) \u0026\u0026 !v.strip.empty?\n  v.is_a?(Array) ? v : []\n}\n\n# ===== COUNTRY: explicit input, else from Luma registration answers =====\nra = parse.(input[\"registration_answers\"])\nby_label   = -\u003e(label) { (hit = ra.find { |a| a[\"label\"] == label }) \u0026\u0026 hit[\"answer\"] }\nby_keyword = -\u003e(words) { (hit = ra.find { |a| l = a[\"label\"].to_s.downcase; words.any? { |w| l.include?(w) } }) \u0026\u0026 hit[\"answer\"] }\ncountry = clean.(input[\"country\"]) ||\n          clean.(by_label.(\"What country are you from?\")) ||\n          clean.(by_label.(\"Where are you from?\")) ||\n          clean.(by_label.(\"Country of residence\")) ||\n          clean.(by_keyword.([\"what country\", \"which country\", \"country\", \"where are you from\",\n                              \"where are you based\", \"based in\", \"residence\", \"nationality\"]))\ncountry = \"United Kingdom\" if country == \"United Kingdon\"\n\n# ===== BLOCKED COUNTRIES =====\ncountry_n = norm.(country)\nmatched_block = country_n.empty? ? nil : parse.(input[\"blocked_countries\"]).find { |b|\n  b.is_a?(Hash) \u0026\u0026\n    ((!norm.(b[\"country\"]).empty? \u0026\u0026 norm.(b[\"country\"]) == country_n) ||\n     (!norm.(b[\"country_iso_code\"]).empty? \u0026\u0026 norm.(b[\"country_iso_code\"]) == country_n))\n}\ncountry_blocked = !matched_block.nil?\n\n# ===== IGNORE LIST (Postgres marketing.ignore_list) =====\nemail  = input[\"email\"].to_s.strip.downcase\ndomain = email.include?(\"@\") ? email.split(\"@\").last : \"\"\npg_match = input[\"pg_match_count\"].to_i \u003e 0\n\nreasons = []\nreasons \u003c\u003c (clean.(input[\"pg_match_type\"]) || \"email_match\") if pg_match\nreasons \u003c\u003c \"blocked_country: #{country}\" if country_blocked\n\n{\n  email: email, email_domain: domain, country: country,\n  pg_match_type: pg_match ? (clean.(input[\"pg_match_type\"]) || \"email_match\") : nil,\n  country_blocked: country_blocked,\n  blocked_country_iso: country_blocked ? matched_block[\"country_iso_code\"] : nil,\n  should_ignore: !reasons.empty?,\n  ignore_reason: reasons.empty? ? nil : reasons.join(\" | \")\n}\n",
              "code_input": {
                "data": {},
                "schema": "[{\"name\": \"email\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Email\", \"parent\": [\"code_input\", \"data\"]}, {\"name\": \"country\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Country\", \"parent\": [\"code_input\", \"data\"]}, {\"name\": \"registration_answers\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Registration answers\", \"parent\": [\"code_input\", \"data\"]}, {\"name\": \"pg_match_count\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Pg match count\", \"parent\": [\"code_input\", \"data\"]}, {\"name\": \"pg_match_type\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Pg match type\", \"parent\": [\"code_input\", \"data\"]}, {\"name\": \"blocked_countries\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Blocked countries\", \"parent\": [\"code_input\", \"data\"]}]"
              },
              "code_output_schema_json": "[{\"name\": \"email\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Email\"}, {\"name\": \"email_domain\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Email domain\"}, {\"name\": \"country\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Country\"}, {\"name\": \"pg_match_type\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Pg match type\"}, {\"name\": \"country_blocked\", \"type\": \"boolean\", \"optional\": true, \"control_type\": \"checkbox\", \"label\": \"Country blocked\"}, {\"name\": \"blocked_country_iso\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Blocked country iso\"}, {\"name\": \"should_ignore\", \"type\": \"boolean\", \"optional\": true, \"control_type\": \"checkbox\", \"label\": \"Should ignore\"}, {\"name\": \"ignore_reason\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Ignore reason\"}]",
              "name": "check_guest_ignore",
              "payload_asset_type": "inline"
            },
