          {
            "as": "c2b00010",
            "comment": "resolve person (Contact wins over Lead) + campaign",
            "description": "Execute \u003cspan class=\"provider\"\u003eruby\u003c/span\u003e code: \u003cspan class=\"provider\"\u003eresolve_person_campaign\u003c/span\u003e",
            "input": {
              "code": "sf_id = /\\A[a-zA-Z0-9]{15}([a-zA-Z0-9]{3})?\\z/\ncontact_id = input[\"contact_id\"].to_s.strip\nlead_id    = input[\"lead_id\"].to_s.strip\ncampaign_id = input[\"campaign_id\"].to_s.strip\nperson_type, person_id =\n  if contact_id.match?(sf_id) then [\"Contact\", contact_id]\n  elsif lead_id.match?(sf_id) then [\"Lead\", lead_id]\n  else [nil, nil]\n  end\ncampaign_issue =\n  if campaign_id.empty? then \"Luma slug not found in campaign sheet: #{input[\"luma_url_slug\"]}\"\n  elsif !campaign_id.match?(sf_id) then \"Invalid SF campaign ID in sheet: #{campaign_id}\"\n  end\nresult_status, result_message =\n  if person_id.nil? then [\"Not found\", [\"No Salesforce Contact or Lead for this email\", campaign_issue].compact.join(\" | \")]\n  elsif campaign_issue then [\"Campaign not found\", campaign_issue]\n  end\n{\n  person_type: person_type, person_id: person_id, campaign_id: campaign_id,\n  contact_id: person_type == \"Contact\" ? person_id : nil,\n  lead_id:    person_type == \"Lead\" ? person_id : nil,\n  member_query: person_id \u0026\u0026 \"CampaignId = '#{campaign_id}' AND #{person_type}Id = '#{person_id}'\",\n  campaign_ok: campaign_issue.nil?,\n  result_status: result_status, result_message: result_message\n}\n",
              "code_input": {
                "data": {},
                "schema": "[{\"name\": \"contact_id\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Contact id\", \"parent\": [\"code_input\", \"data\"]}, {\"name\": \"lead_id\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Lead id\", \"parent\": [\"code_input\", \"data\"]}, {\"name\": \"campaign_id\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Campaign id\", \"parent\": [\"code_input\", \"data\"]}, {\"name\": \"luma_url_slug\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Luma url slug\", \"parent\": [\"code_input\", \"data\"]}]"
              },
              "code_output_schema_json": "[{\"name\": \"person_type\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Person type\"}, {\"name\": \"person_id\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Person id\"}, {\"name\": \"campaign_id\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Campaign id\"}, {\"name\": \"contact_id\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Contact id\"}, {\"name\": \"lead_id\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Lead id\"}, {\"name\": \"member_query\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Member query\"}, {\"name\": \"campaign_ok\", \"type\": \"boolean\", \"optional\": true, \"control_type\": \"checkbox\", \"label\": \"Campaign ok\"}, {\"name\": \"result_status\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Result status\"}, {\"name\": \"result_message\", \"type\": \"string\", \"optional\": true, \"control_type\": \"text\", \"label\": \"Result message\"}]",
              "name": "resolve_person_campaign",
