            "input": {
              "code": "email = input[\"email\"].to_s.strip.downcase\nvalid = email.match?(/\\A[^@\\s'\\\\]+@[^@\\s'\\\\]+\\.[^@\\s'\\\\]+\\z/)\nmember_status = { \"approved\" =\u003e \"Registered = Approved\", \"pending_approval\" =\u003e \"Registered = Pending\" }[input[\"approval_status\"].to_s.strip.downcase]\nskip_reason =\n  if !valid then \"Invalid email: #{email}\"\n  elsif member_status.nil? then \"Unsupported Luma approval status: #{input[\"approval_status\"]}\"\n  end\n{ email: email, member_status: member_status, skip_reason: skip_reason }\n",
              "code_input": {
                "data": {},
